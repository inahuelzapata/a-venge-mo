# Copy to backend/.env (git-ignored) and pick ONE target.
# The scripts refuse to run until these are set.

# --- Local emulator ---------------------------------------------------------
FIREBASE_TARGET=emulator
FIREBASE_PROJECT_ID=demo-split-party
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# --- Hosted Firestore -------------------------------------------------------
# FIREBASE_TARGET=hosted
# FIREBASE_PROJECT_ID=your-firebase-project-id
# Path to a service-account key that lives OUTSIDE this repo:
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/outside/repo/service-account.json
