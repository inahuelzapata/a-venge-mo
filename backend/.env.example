# Copy to backend/.env (git-ignored) and fill in your project id.
# The scripts refuse to run until these are set. Guide: docs/integration-setup-guide.md

# --- Hosted Firestore (default) ----------------------------------------------
FIREBASE_TARGET=hosted
FIREBASE_PROJECT_ID=your-firebase-project-id
# Service-account key from Firebase console > Project settings > Service accounts
# > Generate new private key, saved as backend/service-account.json (git-ignored).
# A relative path is resolved from backend/.
GOOGLE_APPLICATION_CREDENTIALS=service-account.json
# Alternative: leave GOOGLE_APPLICATION_CREDENTIALS empty and use your own
# application-default credentials (gcloud auth application-default login).
# GOOGLE_APPLICATION_CREDENTIALS=

# --- Local emulator (opt-in, offline) -----------------------------------------
# Start it with `npm run emulators`, then comment out the hosted block above and use:
# FIREBASE_TARGET=emulator
# FIREBASE_PROJECT_ID=demo-split-party
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
