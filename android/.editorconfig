root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
max_line_length = 140
ktlint_code_style = android_studio
# Composables are PascalCase functions.
ktlint_function_naming_ignore_when_annotated_with = Composable
# Compose rules (io.nlopez.compose.rules): theme objects used as CompositionLocal-free tokens.
compose_allowed_composition_locals = LocalNow,LocalMinimumInsets,LocalReduceMotion,LocalAvatarImages
